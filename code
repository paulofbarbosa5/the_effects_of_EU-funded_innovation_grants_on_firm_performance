# For a combined table we extract ATT from each panel
extract_att <- function(models, label) {
  sapply(models, function(m) {
    s <- summary(m, agg = "ATT")
    coefs <- s$coeftable
    att_row <- coefs[grep("ATT", rownames(coefs)), , drop = FALSE]
    if (nrow(att_row) == 0) return(c(est = NA, se = NA, p = NA))
    c(est = att_row[1, 1], se = att_row[1, 2], p = att_row[1, 4])
  })
}

