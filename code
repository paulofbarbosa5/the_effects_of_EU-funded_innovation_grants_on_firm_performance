    HQ_allocation_MEUR = c(hq_alloc_m, hq_alloc_m, hq_alloc_m),
    Nonrepayable_support_MEUR = c(nonrepayable_amt_m, nonrepayable_amt_m, nonrepayable_amt_m),
    Repayable_counted_as_cost_MEUR = c(
      repayable_amt_m,
      lambda_intermediate * repayable_amt_m,
      0
    )
  ) %>%
    mutate(
      Total_fiscal_cost_MEUR = HQ_allocation_MEUR +
        Nonrepayable_support_MEUR +
        Repayable_counted_as_cost_MEUR
    )
}

