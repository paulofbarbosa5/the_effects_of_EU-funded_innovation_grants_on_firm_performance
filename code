cat("--- 9. Entropy balancing ---\n")

run_ebal <- function(df, use_slope = TRUE, standardize = TRUE) {
  if (sum(df$treated == 1) == 0 || sum(df$treated == 0) == 0) return(NULL)
  base_covs <- c("pre_lsales", "pre_emp", "pre_expint", "pre_lassets")
  covs <- if (use_slope) c(base_covs, "sl_lsales") else base_covs
  dat <- df
  if (standardize) {
    dat <- dat %>% mutate(across(all_of(covs), ~ as.numeric(scale(.)),
                                 .names = "{.col}_std"))
    covs <- paste0(covs, "_std")
  }
  fml <- reformulate(covs, response = "treated")
  res <- tryCatch(weightit(fml, data = dat, method = "ebal", estimand = "ATT"),
                  error = function(e) NULL)
  if (is.null(res)) return(NULL)
  out <- df %>% mutate(w = as.numeric(res$weights))
  ctrl <- out$treated == 0 & is.finite(out$w)
  if (any(ctrl)) {
    cap <- quantile(out$w[ctrl], 0.99, na.rm = TRUE)
    out$w[ctrl] <- pmin(out$w[ctrl], cap)
  }
  out$w[out$treated == 1] <- 1
  out
}

assign_weights_by <- function(df, group_vars, use_slope = TRUE, standardize = TRUE) {
  df %>%
    group_by(across(all_of(group_vars))) %>%
    group_modify(~ {
      res <- run_ebal(.x, use_slope = use_slope, standardize = standardize)
      if (is.null(res)) tibble() else res
    }) %>%
    ungroup() %>%
    select(tina, w)
}

