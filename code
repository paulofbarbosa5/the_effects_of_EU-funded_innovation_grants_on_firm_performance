)

# *********************************************************
#        10. PSM (Panel C)                                #
# *********************************************************

cat("--- 10. Propensity score matching ---\n")

set.seed(42)

# Impute missing pre-treatment features within strata
pre_feats_clean <- pre_feats %>%
  group_by(setor2, t0_bin, firm_size0, treated) %>%
  mutate(
    pre_lsales  = ifelse(is.na(pre_lsales),  median(pre_lsales,  na.rm = TRUE), pre_lsales),
    pre_emp     = ifelse(is.na(pre_emp),      median(pre_emp,     na.rm = TRUE), pre_emp),
    pre_expint  = ifelse(is.na(pre_expint),   median(pre_expint,  na.rm = TRUE), pre_expint),
    pre_lassets = ifelse(is.na(pre_lassets),  median(pre_lassets, na.rm = TRUE), pre_lassets),
    sl_lsales   = ifelse(is.na(sl_lsales), 0, sl_lsales)
  ) %>%
  ungroup()

ps_form <- treated ~ pre_lsales + pre_emp + pre_expint + pre_lassets + sl_lsales

# PSM nearest-neighbor
m_psm <- matchit(
  ps_form,
  data       = pre_feats_clean,
  method     = "nearest",
  distance   = "glm",
  exact      = ~ t0_bin,
  caliper    = 0.2,
  std.caliper = TRUE,
  ratio      = 2,
  replace    = TRUE
)

# Balance diagnostics (print to log)
cat("\n== PSM Balance ==\n")
print(bal.tab(m_psm, un = TRUE, stats = c("m", "v"),
              thresholds = c(m = 0.1, v = 2)))

# ESS
md <- match.data(m_psm)
ess_trt_psm  <- (sum(md$weights[md$treated == 1])^2) / sum(md$weights[md$treated == 1]^2)
ess_ctrl_psm <- (sum(md$weights[md$treated == 0])^2) / sum(md$weights[md$treated == 0]^2)
cat("  PSM ESS (treated / control):", round(ess_trt_psm, 1), "/", round(ess_ctrl_psm, 1), "\n")

# Merge weights to panel
w_psm_df <- md[, c("tina", "weights")] %>%
  distinct() %>%
  rename(w_psm = weights)

df_psm <- df_est %>%
  mutate(tina = as.character(tina)) %>%
  inner_join(w_psm_df %>% mutate(tina = as.character(tina)), by = "tina") %>%
  filter(sample %in% c(1, 2)) %>%
  mutate(
    treated      = as.integer(sample == 1),
    inov_ano_inc = ifelse(sample == 1, inov_ano_inc, 100000L)
  )

