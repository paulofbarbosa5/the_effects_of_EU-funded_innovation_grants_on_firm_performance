.safe_log1 <- function(x) log(pmax(x, 1))
.safe_mean <- function(x) if (all(is.na(x))) NA_real_ else mean(x, na.rm = TRUE)
.safe_slope <- function(y, x) {
  ok <- is.finite(y) & is.finite(x)
  if (sum(ok) < 2) return(0)
  tryCatch(unname(coef(lm(y[ok] ~ x[ok]))[2]), error = function(e) 0)
}

app <- df_analysis2 %>%
  filter(sample %in% c(1, 2)) %>%
  mutate(t0 = as.integer(inov_ano_inc), treated = as.integer(sample == 1)) %>%
  filter(!is.na(t0))

YEAR_MIN <- 2014L
YEAR_MAX <- 2022L

pre_feats <- app %>%
  group_by(tina) %>%
  summarise(t0 = first(t0), .groups = "drop") %>%
  inner_join(app, by = c("tina", "t0")) %>%
  group_by(tina) %>%
  mutate(
    setor2 = first(setor2),
    district = first(district),
    firm_size0 = first(firm_size)
  ) %>%
  ungroup() %>%
  mutate(
    pre_start = pmax(t0 - 3L, YEAR_MIN),
    pre_end = pmin(t0 - 1L, YEAR_MAX)
  ) %>%
  filter(ano >= pre_start & ano <= pre_end) %>%
  arrange(tina, ano) %>%
  group_by(tina, t0, setor2, district, firm_size0) %>%
  summarise(
    n_pre = n(),
    pre_lsales  = .safe_mean(.safe_log1(VF16132)),
    pre_emp     = .safe_mean(pmax(employess, 1)),
    pre_expint  = .safe_mean(int_export),
    pre_lassets = .safe_mean(.safe_log1(fixed_assets)),
    sl_lsales   = .safe_slope(.safe_log1(VF16132), ano),
    .groups = "drop"
  ) %>%
  inner_join(app %>% distinct(tina, treated, t0), by = c("tina", "t0")) %>%
  mutate(
    tina = as.character(tina),
    t0_bin = cut(
      t0,
      breaks = c(2014, 2016, 2018, 2022),
      labels = c("15-16", "17-18", "19-22"),
      include.lowest = TRUE,
      right = TRUE
    )
  )

