safe_ratio <- function(num, den) {
  ifelse(is.finite(num) & is.finite(den) & den > 0, num / den, NA_real_)
}

to_int <- function(x) {
  x <- haven::zap_labels(x)
  as.integer(suppressWarnings(as.numeric(as.character(x))))
}

write_tabular_tex <- function(df, file, digits = 2, align = NULL) {
  tex <- knitr::kable(
    df,
    format = "latex",
    booktabs = TRUE,
    longtable = FALSE,
    table.envir = FALSE,
    digits = digits,
    escape = FALSE,
    align = align
  )
  writeLines(tex, file)
}

fmt_cell <- function(est, se, p, n) {
  stars <- ifelse(
    is.na(p), "",
    ifelse(p < 0.01, "***", ifelse(p < 0.05, "**", ifelse(p < 0.1, "*", "")))
  )
  sprintf("%.4f%s (%.4f) [N=%d]", est, stars, se, as.integer(n))
}

extract_att <- function(models) {
  sapply(models, function(m) {
    s <- summary(m, agg = "ATT")
    ct <- s$coeftable
    att_row <- ct[grep("ATT", rownames(ct)), , drop = FALSE]
    if (nrow(att_row) == 0) {
      return(c(est = NA_real_, se = NA_real_, p = NA_real_, n = stats::nobs(m)))
    }
    c(est = att_row[1, 1], se = att_row[1, 2], p = att_row[1, 4], n = stats::nobs(m))
  })
}

# -------------------------------------------------------------------------
# Extract aggregated event-study coefficients (the same shown in fixest::iplot)
# -------------------------------------------------------------------------
extract_event_coefs <- function(model, event_window = 0:5, pre_window = -5:-2) {

  tmp <- as.data.frame(fixest::iplot(model, only.params = TRUE))

  out <- tmp %>%
    dplyr::transmute(
      event_time = as.integer(prms.x),
      beta       = prms.estimate,
      ci_low     = prms.ci_low,
      ci_high    = prms.ci_high,
      std.error  = (prms.ci_high - prms.ci_low) / (2 * qnorm(0.975)),
      p.value    = 2 * pnorm(-abs(prms.estimate / ((prms.ci_high - prms.ci_low) / (2 * qnorm(0.975))))),
      term       = prms.estimate_names_raw,
      is_ref     = prms.is_ref
    ) %>%
    dplyr::filter(is_ref == FALSE) %>%
    dplyr::arrange(event_time)

  list(
    all  = out,
    post = out %>% dplyr::filter(event_time %in% event_window) %>% dplyr::arrange(event_time),
    pre  = out %>% dplyr::filter(event_time %in% pre_window) %>% dplyr::arrange(event_time)
  )
}

# -------------------------------------------------------------------------
# Unified event-study coefficient table with N
# -------------------------------------------------------------------------
extract_event_table <- function(model, outcome_name, panel_name, dat,
                                dv_var, logged = FALSE,
                                event_window = 0:5, pre_window = -5:-2) {

  ev <- extract_event_coefs(model, event_window = event_window, pre_window = pre_window)

  out <- bind_rows(ev$pre, ev$post) %>%
    dplyr::mutate(
      period = ifelse(event_time < 0, "pre", "post"),
      panel = panel_name,
      outcome = outcome_name,
      N_model = stats::nobs(model)
    )

  # Count treated observations by event time among observations that actually enter lhs
  tmp_dat <- dat %>%
    dplyr::mutate(event_time = ano - inov_ano_inc)

  y <- tmp_dat[[dv_var]]
  y_ok <- if (logged) is.finite(y) & y > 0 else is.finite(y)
  tmp_dat$y_ok <- y_ok

  counts <- tmp_dat %>%
    dplyr::filter(sample == 1, y_ok, event_time %in% out$event_time) %>%
    dplyr::group_by(event_time) %>%
    dplyr::summarise(
      treated_obs_event = dplyr::n(),
      treated_firms_event = dplyr::n_distinct(tina),
      .groups = "drop"
    )

  out %>%
    dplyr::left_join(counts, by = "event_time") %>%
    dplyr::select(panel, outcome, term, event_time, period,
                  beta, std.error, ci_low, ci_high, p.value,
                  N_model, treated_obs_event, treated_firms_event)
}

# -------------------------------------------------------------------------
# Joint pre-trend tests
#   - p_internal_wald : standard internal fixest test
#   - p_agg_diag      : approximate joint test on the aggregated plotted leads,
#                       assuming independence across pre-leads
# -------------------------------------------------------------------------
approx_pretrend_test <- function(df_one) {
  pre <- df_one %>%
    dplyr::filter(period == "pre",
                  is.finite(beta), is.finite(std.error), std.error > 0)

  if (nrow(pre) == 0) {
    return(tibble(
      n_pre_coef = 0L,
      chi2_diag = NA_real_,
      p_agg_diag = NA_real_,
      min_pre_p = NA_real_
    ))
  }

  W <- sum((pre$beta / pre$std.error)^2)
  pW <- pchisq(W, df = nrow(pre), lower.tail = FALSE)

  tibble(
    n_pre_coef = nrow(pre),
    chi2_diag = W,
    p_agg_diag = pW,
    min_pre_p = min(pre$p.value, na.rm = TRUE)
  )
}

make_pretrend_table <- function(models_list, panel_name, event_table_all) {
  internal <- tibble(
    panel = panel_name,
    outcome = names(models_list),
    p_internal_wald = sapply(models_list, function(m) {
      w <- try(wald(m, keep = "^ano::-[1-5]"), silent = TRUE)
      if (inherits(w, "try-error")) NA_real_ else w$p
    }),
    N_model = sapply(models_list, stats::nobs)
  )

  pretty_names <- c(
    export_any   = "Export probability (dummy)",
    int_export   = "Export intensity",
    totExports   = "Total exports",
    fixed_assets = "Fixed assets",
    sales        = "Sales",
    wages        = "Wages",
    employment   = "Employees",
    labor_prod   = "Labour productivity",
    kl_ratio     = "K-L ratio"
  )

  internal <- internal %>%
    dplyr::mutate(outcome_label = pretty_names[outcome])

  approx <- event_table_all %>%
    dplyr::filter(panel == panel_name) %>%
    dplyr::group_by(panel, outcome, N_model) %>%
    dplyr::group_modify(~ approx_pretrend_test(.x)) %>%
    dplyr::ungroup() %>%
    dplyr::rename(outcome_label = outcome)

  pre_counts <- event_table_all %>%
    dplyr::filter(panel == panel_name, period == "pre") %>%
    dplyr::group_by(panel, outcome) %>%
    dplyr::summarise(
      treated_obs_pre_total = sum(treated_obs_event, na.rm = TRUE),
      treated_firms_pre_max = max(treated_firms_event, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    dplyr::rename(outcome_label = outcome)

  internal %>%
    dplyr::left_join(
      approx %>% dplyr::select(panel, outcome_label, n_pre_coef, chi2_diag, p_agg_diag, min_pre_p),
      by = c("panel", "outcome_label")
    ) %>%
    dplyr::left_join(
      pre_counts,
      by = c("panel", "outcome_label")
    ) %>%
    dplyr::select(
      panel, outcome = outcome_label, N_model,
      n_pre_coef, treated_obs_pre_total, treated_firms_pre_max,
      p_internal_wald, chi2_diag, p_agg_diag, min_pre_p
    )
}

