run_panel <- function(dat, suffix, controls = "", results_tables, results_figures) {
  # Build formulas
  ctrl_str <- if (nchar(controls) > 0) paste0(" + ", controls) else ""
  
  specs <- list(
    int_export   = list(dv = "int_export",         log = FALSE),
    totExports   = list(dv = "totExports",          log = TRUE),
    fixed_assets = list(dv = "fixed_assets",        log = TRUE),
    sales        = list(dv = "VF16132",             log = TRUE),
    wages        = list(dv = "VF15557",             log = TRUE),
    employment   = list(dv = "employess_pos",       log = TRUE),
    labor_prod   = list(dv = "labor_prod",          log = TRUE),
    kl_ratio     = list(dv = "kl_ratio",            log = TRUE)
  )
  
  models <- lapply(specs, function(s) {
    lhs <- if (s$log) paste0("log(", s$dv, ")") else s$dv
    fml <- as.formula(paste0(lhs, " ~ sunab(inov_ano_inc, ano)",
                             ctrl_str,
                             " | tina + ano + district + setor2"))
    feols(fml, data = dat, vcov = ~tina)
  })
  
  # Wald pre-trend tests
  wald_p <- sapply(models, function(m) {
    out <- try(wald(m, keep = "^ano::-[1-5]"), silent = TRUE)
    if (inherits(out, "try-error")) NA_real_ else round(out$p, 3)
  })
  
  # Export table
  etable(
    models,
    agg = "ATT",
    style.tex = style.tex("AER"),
    signif.code = c("***" = 0.01, "**" = 0.05, "*" = 0.1),
    fitstat = ~ r2 + n,
    extralines = list("Parallel Trends (p-value)" = wald_p),
    tex = TRUE,
    file = file.path(results_tables, paste0("did_", suffix, ".tex"))
  )
  
  # Export event-study plots
  plot_names <- c("intExports", "totExports", "assets", "sales",
                  "wage", "emp", "laborProd", "KL")
  for (i in seq_along(models)) {
    fname <- paste0(plot_names[i], "_PT_", suffix, ".png")
    png(file.path(results_figures, fname), width = 900, height = 600)
    iplot(models[[i]], ref.line = TRUE, main = "",
          xlab = "Time to treatment", cex.axis = 1.3, cex.lab = 1.4)
    dev.off()
  }
  
  cat("  Panel", suffix, "saved:", length(models), "models.\n")
  invisible(models)
}

