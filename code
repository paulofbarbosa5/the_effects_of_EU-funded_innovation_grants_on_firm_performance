# simple pre-trend-adjusted robustness based on aggregated plotted pre-leads
if (nrow(ev_B_cost$pre) < 2) {
  deltaA_B_detrended_m <- NA_real_
} else {
  pre_fit <- lm(beta ~ event_time, data = ev_B_cost$pre)
  trend_post <- predict(pre_fit, newdata = data.frame(event_time = ev_B_cost$post$event_time))
  beta_post_adj <- ev_B_cost$post$beta - trend_post

  deltaA_B_detrended_m <- sum(
    event_decomp_B$sum_baseline_fa_2015 * (exp(beta_post_adj) - 1),
    na.rm = TRUE
  ) / 1e6
}

